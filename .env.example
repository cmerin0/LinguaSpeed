# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env — it contains real secrets

# PostgreSQL password for the linguaspeed database user
DB_PASSWORD=changeme

# HS256 JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-32-byte-hex-string

# Seed admin account credentials — change before any public exposure
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Host port the server listens on (default: 3000)
SERVER_PORT=3000

# Scoring formula constants (optional — defaults used if not set)
BASE_POINTS=1000
PENALTY=200
